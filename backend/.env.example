# ─── GlamNow Backend Environment Variables ───
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Application
GLAMNOW_ENVIRONMENT=development
GLAMNOW_DEBUG=false
GLAMNOW_LOG_LEVEL=INFO
GLAMNOW_ALLOWED_ORIGINS=["http://localhost:3000"]
GLAMNOW_API_PREFIX=/api/v1

# Security — MUST be changed in production
GLAMNOW_SECRET_KEY=CHANGE-ME-IN-PRODUCTION

# Database (PostgreSQL)
GLAMNOW_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/glamnow
GLAMNOW_DATABASE_ECHO=false
GLAMNOW_DATABASE_POOL_SIZE=5
GLAMNOW_DATABASE_MAX_OVERFLOW=10

# Redis
GLAMNOW_REDIS_URL=redis://localhost:6379/0

# File uploads
GLAMNOW_MAX_UPLOAD_SIZE_MB=10

# Operational targets
GLAMNOW_QUICK_BOOKING_TARGET_MINUTES=10
