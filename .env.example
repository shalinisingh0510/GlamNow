# ==============================================================================
# GlamNow Environment Configuration Example
# Copy to .env or export into your local environment
# ==============================================================================

# ─── Common / Global ─────────────────────────────────────────────────────────
GLAMNOW_ENV=development
GLAMNOW_LOG_LEVEL=INFO

# ─── Backend Settings ────────────────────────────────────────────────────────
GLAMNOW_SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string-in-production
GLAMNOW_PORT=8000
GLAMNOW_HOST=0.0.0.0
GLAMNOW_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & Cache (PostgreSQL + Redis)
GLAMNOW_DATABASE_URL=postgresql+asyncpg://glamnow_user:glamnow_password@localhost:5432/glamnow_dev
GLAMNOW_REDIS_URL=redis://localhost:6379/0

# Integration Provider Placeholders (Ports & Adapters)
GLAMNOW_RAZORPAY_KEY_ID=rzp_test_placeholder
GLAMNOW_RAZORPAY_KEY_SECRET=rzp_secret_placeholder
GLAMNOW_GOOGLE_MAPS_API_KEY=maps_api_key_placeholder
GLAMNOW_AWS_S3_BUCKET=glamnow-media-dev
GLAMNOW_SMS_GATEWAY_AUTH_KEY=sms_auth_key_placeholder

# ─── Frontend Settings (Next.js Public Envs) ─────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME=GlamNow
NEXT_PUBLIC_ENABLE_TAILORING_STUDIO=true
NEXT_PUBLIC_ENABLE_EXPRESS_DISPATCH=true
